# MUN Command Center — environment configuration
# Copy this file to `.env` and fill in what you have.
# `.env` is gitignored and its values NEVER reach the browser.
# The app runs fully without any key set — AI features simply report
# "AI unavailable" and the local knowledge base keeps working.

# --- Your committee assignment ---
# This is the first thing to set. Everything follows from it: the top bar, the
# dashboard, the speakers list and every AI prompt read these values, so the app
# works for any delegation in any committee without editing a line of code.
# Read once at startup — restart the server after changing them.
MUN_COUNTRY=Your Delegation
MUN_COUNTRY_CODE=ZZ
MUN_COMMITTEE=UNGA
MUN_AGENDA=
MUN_CONFERENCE=
MUN_FLAG=🏳
MUN_DATES=

# Delegations you are coordinating with — classmates holding other countries in
# the same committee. ISO-3166 alpha-2 codes, comma separated. The AI is told to
# treat them as partners and never to speak for them. Leave blank if you have none.
MUN_ALLIES=

# --- AI provider (optional) ---
ANTHROPIC_API_KEY=

# Alternative providers, selectable from Settings. Leave blank if unused.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Server ---
PORT=8788

# Which network interface to listen on. Leave this as 127.0.0.1.
#
# 127.0.0.1 means "this machine only" and is the only safe setting. This app has
# NO LOGIN: there is no password, no account and no session. Its entire security
# model is that nothing outside your own computer can reach it.
#
# Setting HOST to anything else (0.0.0.0, or your LAN address) makes the app
# reachable from other devices on the same network — and on conference or school
# wifi, "the same network" includes every other delegate in the room. Anyone who
# can reach the port can read your live transcript, all your notes and every
# prepared speech, and can spend your API key through the AI endpoints.
#
# Because that is almost never what someone means to do, HOST alone is not
# enough: the server refuses to start unless MUN_ALLOW_LAN=1 is also set, and it
# prints a warning on every boot while it is exposed. Only do this on a network
# you control, and unset it afterwards.
HOST=127.0.0.1
# MUN_ALLOW_LAN=1

# --- Data location ---
# Where the SQLite database, cache and any recordings live.
# Defaults to %LOCALAPPDATA%\mun-command-center on Windows.
# Keep this OUTSIDE any cloud-synced folder (OneDrive/Dropbox) — a live
# SQLite file inside a syncing folder risks lock contention and corruption.
# MUN_DATA_DIR=C:\Users\you\AppData\Local\mun-command-center

# --- Source documents ---
# Folder the importer reads from. Files are read-only; originals are never modified.
MUN_SOURCE_DIR=..
