{
  "name": "mun-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first MUN Live Command Center - Canada, UNGA, RPSIS 2026",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "go": "npm run build && npm run start",
    "start": "cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/db/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "check-publishable": "node ../scripts/check-publishable.mjs --all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-query": "^5.90.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.10.38",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
